@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<style>
    .profile-hero {
        background: linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%);
        height: 200px;
        border-radius: 0 0 20px 20px;
        margin-bottom: 80px;
    }
    .profile-card {
        margin-top: -100px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0,0,0,0.1);
    }
    .avatar-wrapper {
        position: relative;
        width: 160px;
        height: 160px;
        margin: 0 auto;
    }
    .avatar-img {
        width: 160px; 
        height: 160px; 
        object-fit: cover;
        border: 5px solid white;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }
    .btn-camera {
        width: 40px;
        height: 40px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        bottom: 10px;
        right: 10px;
        border: 3px solid white;
    }
</style>

<div class="profile-hero shadow-sm"></div>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="row">
                <!-- Left Column: Avatar & Quick Info -->
                <div class="col-md-4 mb-4">
                    <div class="card profile-card shadow rounded-4 text-center p-4 h-100">
                        <div class="avatar-wrapper mb-3">
                            <img id="profileAvatar" src="/images/default-avatar.png" 
                                 class="rounded-circle avatar-img" 
                                 alt="Profile Picture"
                                 onerror="this.onerror=null; this.src='/images/default-avatar.png';">
                            
                            <button class="btn btn-primary rounded-circle position-absolute btn-camera shadow-sm" 
                                    onclick="document.getElementById('avatarInput').click()"
                                    title="Change Profile Picture">
                                <i class="bi bi-camera-fill"></i>
                            </button>
                            <input type="file" id="avatarInput" hidden accept="image/*">
                        </div>
                        
                        <h3 id="profileName" class="fw-bold mb-1">Loading...</h3>
                        <p id="profileRole" class="text-secondary fw-semibold text-uppercase small ls-1">...</p>
                        
                        <hr class="my-4 opacity-10">
                        
                        <div class="text-start px-2">
                             <small class="text-muted d-block mb-2 text-uppercase fw-bold" style="font-size: 0.75rem;">Contact Info</small>
                             <div class="d-flex align-items-center mb-2">
                                 <i class="bi bi-envelope text-primary me-2"></i>
                                 <span id="displayEmail" class="text-truncate">...</span>
                             </div>
                             <div class="d-flex align-items-center mb-2">
                                 <i class="bi bi-telephone text-primary me-2"></i>
                                 <span id="displayPhone">...</span>
                             </div>
                             <div class="d-flex align-items-center">
                                 <i class="bi bi-geo-alt text-primary me-2"></i>
                                 <span id="displayAddress">...</span>
                             </div>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Edit Form -->
                <div class="col-md-8 mb-4">
                    <div class="card shadow border-0 rounded-4 h-100">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-center">
                            <h4 class="fw-bold mb-0">Profile Settings</h4>
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-pencil me-1"></i> Editable
                            </span>
                        </div>
                        <div class="card-body p-4">
                            <form id="profileForm">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="text" class="form-control" id="fullName" placeholder="Full Name" required>
                                            <label for="fullName">Full Name</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="email" class="form-control bg-light" id="email" placeholder="Email" disabled>
                                            <label for="email">Email Address</label>
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <div class="form-floating">
                                            <input type="tel" class="form-control" id="phoneNumber" placeholder="Phone Number">
                                            <label for="phoneNumber">Phone Number</label>
                                        </div>
                                    </div>
                                    <div class="col-md-6" id="specialtyContainer">
                                        <div class="form-floating">
                                            <input type="text" class="form-control" id="specialty" placeholder="Specialty">
                                            <label for="specialty">Specialty / Title</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <input type="text" class="form-control" id="address" placeholder="Address">
                                            <label for="address">Address / Location</label>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="form-floating">
                                            <textarea class="form-control" id="bio" placeholder="Bio" style="height: 120px"></textarea>
                                            <label for="bio">Professional Bio</label>
                                        </div>
                                    </div>

                                    <div class="col-12 d-flex justify-content-end mt-4">
                                        <button type="submit" class="btn btn-primary px-5 py-2 rounded-pill fw-bold shadow-sm" id="btnSave">
                                            <i class="bi bi-check2-circle me-2"></i> Save Changes
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/Profile/profile.js"></script>
}
