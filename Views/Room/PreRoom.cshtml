@model Telemedicine.Web.Models.RoomDetailsViewModel
@{
    ViewData["Title"] = "Waiting Room";
    var userIdString = Context.Request.Cookies["userId"];
    var userRole = Context.Request.Cookies["userRole"];
    int.TryParse(userIdString, out int currentUserId);
    bool isDoctor = currentUserId == Model.DoctorId || userRole == "Doctor";
    string roomLink = $"{Context.Request.Scheme}://{Context.Request.Host}/Room/PreRoom/{Model.RoomId}";
}

<div class="container mt-5">
    <div class="card shadow-lg mx-auto" style="max-width: 800px;">
        <div class="card-header bg-primary text-white text-center py-4">
            <h2 class="mb-0"><i class="bi bi-camera-video"></i> Consultation Room</h2>
            <p class="mb-0 mt-2 opacity-75">@(isDoctor ? "Patient Information" : "Waiting for Doctor")</p>
        </div>
        <div class="card-body p-5">
            <div class="row mb-4">
                <div class="col-md-6 border-end">
                    <h5 class="text-muted small text-uppercase">Appointment Details</h5>
                    <p class="fs-5 mb-1"><strong>Date:</strong> @Model.ScheduledTime.ToLocalTime().ToString("f")</p>
                    <p class="fs-5 mb-1"><strong>Status:</strong> <span class="badge bg-@((Model.Status == "Completed") ? "secondary" : "success")">@Model.Status</span></p>
                </div>
                <div class="col-md-6 ps-md-4">
                    <h5 class="text-muted small text-uppercase">Participants</h5>
                    <p class="mb-1"><strong>Doctor:</strong> Dr. @Model.DoctorName</p>
                    <p class="mb-1"><strong>Patient:</strong> @Model.PatientName</p>
                </div>
            </div>

            <div class="alert alert-light border rounded-3 p-4 mb-4">
                <h5 class="text-primary"><i class="bi bi-info-circle"></i> Reason for Visit</h5>
                <p class="lead mb-0">@(string.IsNullOrEmpty(Model.Reason) ? "No reason provided." : Model.Reason)</p>
            </div>

            @if (isDoctor)
            {
                 <div class="mb-4">
                    <label class="form-label small text-muted">Room Link (Share with Patient)</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="@roomLink" readonly id="roomLinkInput">
                        <button class="btn btn-outline-secondary" type="button" onclick="copyLink()">
                            <i class="bi bi-clipboard"></i> Copy
                        </button>
                    </div>
                </div>
                <div class="d-grid gap-2">
                    <a href="/Room/Index/@Model.RoomId" class="btn btn-primary btn-lg py-3">
                        <i class="bi bi-play-circle-fill"></i> Start Consultation
                    </a>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <div class="spinner-border text-primary mb-3" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h4>Waiting for Dr. @Model.DoctorName...</h4>
                    <p class="text-muted">The doctor will start the consultation shortly. Please stay on this page.</p>
                    
                    <a href="/Room/Index/@Model.RoomId" class="btn btn-outline-primary mt-3">
                        <i class="bi bi-box-arrow-in-right"></i> Enter Room Now
                    </a>
                </div>
            }
        </div>
        <div class="card-footer text-muted text-center py-3">
            <small>Session ID: @Model.RoomId</small>
        </div>
    </div>
</div>

<script>
    function copyLink() {
        var copyText = document.getElementById("roomLinkInput");
        copyText.select();
        copyText.setSelectionRange(0, 99999); 
        navigator.clipboard.writeText(copyText.value);
        alert("Link copied to clipboard!");
    }
</script>
